# Bu dosyayı .env olarak kopyalayıp doldurun. .env repoya girmez.

# Mapbox: yalnızca genel (pk.) anahtar, URL kısıtlamalı
VITE_MAPBOX_TOKEN=pk.xxxxx

# Supabase: arayüz için (yalnızca okuma, RLS açık)
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=xxxxx

# Supabase: SADECE yerel yükleme betiği için. Asla arayüze ya da repoya koymayın.
SUPABASE_SERVICE_ROLE_KEY=
